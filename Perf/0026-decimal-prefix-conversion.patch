+ * merchantability and fitness for a particular purpose.  The software
+ * provided hereunder is on an "as is" basis, and Paul Falstad and the
+ * Zsh Development Group have no obligation to provide maintenance,
+ * support, updates, enhancements, or modifications.
+ *
+ */
+
+/* Test-only original 5.9.2 conversion oracle. */
+static zlong
+reference_zstrtol_underscore(const char *s, char **t, int base, int underscore)
+{
+    const char *inp, *trunc = NULL;
+    zulong calc = 0, newcalc = 0;
+    int neg;
+
+    while (inblank(*s))
+	s++;
+
+    if ((neg = IS_DASH(*s)))
+	s++;
+    else if (*s == '+')
+	s++;
+
+    if (!base) {
+	if (*s != '0')
+	    base = 10;
+	else if (*++s == 'x' || *s == 'X')
+	    base = 16, s++;
+	else if (*s == 'b' || *s == 'B')
+	    base = 2, s++;
+	else
+	    base = 8;
+    }
+    inp = s;
+    if (base < 2 || base > 36) {
+	zerr("invalid base (must be 2 to 36 inclusive): %d", base);
+	return (zlong)0;
+    } else if (base <= 10) {
+	for (; (*s >= '0' && *s < ('0' + base)) ||
+		 (underscore && *s == '_'); s++) {
+	    if (trunc || *s == '_')
+		continue;
+	    newcalc = calc * base + *s - '0';
+	    if (newcalc < calc)
+	    {
+		trunc = s;
+		continue;
+	    }
+	    calc = newcalc;
+	}
+    } else {
+	for (; idigit(*s) || (*s >= 'a' && *s < ('a' + base - 10))
+	     || (*s >= 'A' && *s < ('A' + base - 10))
+	     || (underscore && *s == '_'); s++) {
+	    if (trunc || *s == '_')
+		continue;
+	    newcalc = calc*base + (idigit(*s) ? (*s - '0') : (*s & 0x1f) + 9);
+	    if (newcalc < calc)
+	    {
+		trunc = s;
+		continue;
+	    }
+	    calc = newcalc;
+	}
+    }
+
+    /*
+     * Special case: check for a number that was just too long for
+     * signed notation.
+     * Extra special case: the lowest negative number would trigger
+     * the first test, but is actually representable correctly.
+     * This is a 1 in the top bit, all others zero, so test for
+     * that explicitly.
+     */
+    if (!trunc && (zlong)calc < 0 &&
+	(!neg || calc & ~((zulong)1 << (8*sizeof(zulong)-1))))
+    {
+	trunc = s - 1;
+	calc /= base;
+    }
+
+    if (trunc)
+	zwarn("number truncated after %d digits: %s", (int)(trunc - inp), inp);
+
+    if (t)
+	*t = (char *)s;
+    return neg ? -(zlong)calc : (zlong)calc;
+}
diff --git a/Perf/strtol-module.c b/Perf/strtol-module.c
new file mode 100644
index 0000000..1ffab5e
--- /dev/null
+++ b/Perf/strtol-module.c
@@ -0,0 +1,115 @@
+/* Test-only conversion API fixture; compile against the configured host SDK. */
+#include "zsh.mdh"
+#include <errno.h>
+#include <limits.h>
+#include "strtol-reference.c"
+
+static unsigned checks;
+static int use_reference;
+
+static void
+one(const char *source, int base, int underscore)
+{
+    unsigned offset, with_end, seed;
+    size_t n = strlen(source);
+    for (offset = 0; offset < 2; offset++) {
+        char *allocation = zalloc(offset + n + 1), *s = allocation + offset;
+        char *before = zalloc(offset + n + 1);
+        memset(allocation, 0xa5, offset + n + 1);
+        memcpy(s, source, n + 1);
+        memcpy(before, allocation, offset + n + 1);
+        for (with_end = 0; with_end < 2; with_end++)
+            for (seed = 0; seed < 2; seed++) {
+                char *end = NULL;
+                zlong value;
+                int saved_error;
+                errflag = 0;
+                errno = seed ? E2BIG : 0;
+                value = use_reference ?
+                    reference_zstrtol_underscore(s, with_end ? &end : NULL, base, underscore) :
+                    zstrtol_underscore(s, with_end ? &end : NULL, base, underscore);
+                saved_error = errno;
+                printf("%u:%lld:%ld:%d:%d\n", ++checks, (long long)value,
+                       end ? (long)(end - s) : -1L, errflag, saved_error);
+                errflag = 0;
+                if (memcmp(before, allocation, offset + n + 1)) {
+                    fprintf(stderr, "fixture input changed\n");
+                    exit(91);
+                }
+            }
+        zfree(before, offset + n + 1);
+        zfree(allocation, offset + n + 1);
+    }
+}
+
+static void
+buffer(const char *s)
+{
+    static const int bases[] = {0, 2, 8, 10, 16, 36, -1, 1, 37, INT_MIN, INT_MAX};
+    static const int underscores[] = {0, 1, -7};
+    unsigned b, u;
+    for (b = 0; b < sizeof(bases)/sizeof(bases[0]); b++)
+        for (u = 0; u < sizeof(underscores)/sizeof(underscores[0]); u++)
+            one(s, bases[b], underscores[u]);
+}
+
+static int
+bin_check(UNUSED(char *name), char **args, UNUSED(Options ops), UNUSED(int func))
+{
+    static const char *const atoms[] = {
+        "", "0", "1", "9", "10", "99", "12345678", "123456789", "1234567890",
+        "999999999", "1000000000", "_1", "1_", "1__2", "_", "__", "1.25", "1e2",
+        "1#10", "09", "0x10", "0XfF", "0b10", "0B11", "00000000000000000001",
+        "+1", "-1", " 1", "\t1", "\n1", "\r1", "  +17", " -0x10", "-0",
+        "2147483647", "2147483648", "-2147483648", "-2147483649",
+        "9223372036854775807", "9223372036854775808", "-9223372036854775808",
+        "-9223372036854775809", "18446744073709551615", "18446744073709551616",
+        "18446744073709551620", "1_234_567_890", "1___________________2",
+        "abcdefghijklmnopqrstuvwxyz", "0aZ", "777777777777777777777777777",
+        "\233" "1", "\203" "9", "\303\251" "1", NULL
+    };
+    static const unsigned lengths[] = {0, 1, 2, 7, 8, 9, 10, 18, 19, 20, 31, 64, 128};
+    short saved[256];
+    unsigned variant, i, byte;
+    int saved_errflag = errflag;
+    char s[132];
+    use_reference = !strcmp(args[0], "reference");
+    checks = 0;
+    queue_signals();
+    memcpy(saved, typtab, sizeof(saved));
+    for (variant = 0; variant < 2; variant++) {
+        if (variant) {
+            typtab['1'] |= INBLANK;
+            typtab['_'] |= INBLANK;
+            typtab['q'] |= IDIGIT;
+            typtab['9'] ^= IDIGIT;
+        }
+        for (i = 0; atoms[i]; i++) buffer(atoms[i]);
+        for (i = 0; i < sizeof(lengths)/sizeof(lengths[0]); i++) {
+            memset(s, '9', lengths[i]); s[lengths[i]] = 0; buffer(s);
+            memset(s, '1', lengths[i]); s[lengths[i]] = 0; buffer(s);
+        }
+        for (i = 8; i <= 19; i++)
+            for (byte = 0; byte < 256; byte++) {
+                memset(s, '7', i); s[i] = (char)byte; s[i+1] = '2'; s[i+2] = 0;
+                buffer(s);
+            }
+    }
+    memcpy(typtab, saved, sizeof(saved));
+    errflag = saved_errflag;
+    unqueue_signals();
+    printf("checks=%u\n", checks);
+    fflush(stdout);
+    return 0;
+}
+
+static struct builtin bintab[] = {
+    BUILTIN("psh-strtol-check", 0, bin_check, 1, 1, 0, NULL, NULL)
+};
+static struct features module_features = {bintab, 1, NULL, 0, NULL, 0, NULL, 0, 0};
+int setup_(UNUSED(Module m)) { return 0; }
+int features_(Module m, char ***features) { *features = featuresarray(m, &module_features); return 0; }
+int enables_(Module m, int **enables) { return handlefeatures(m, &module_features, enables); }
+int boot_(UNUSED(Module m)) { return 0; }
+int cleanup_(Module m) { return setfeatureenables(m, &module_features, NULL); }
+int finish_(UNUSED(Module m)) { return 0; }
diff --git a/Perf/check-strtol-module.py b/Perf/check-strtol-module.py
new file mode 100644
index 0000000..401d2ad
--- /dev/null
+++ b/Perf/check-strtol-module.py
@@ -0,0 +1,73 @@
+#!/usr/bin/env python3
+"""Compare numeric values, consumed bytes, errno and diagnostics with original Zsh."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+
+
+def main():
+    root = Path(__file__).resolve().parent.parent
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('baseline', type=Path)
+    p.add_argument('candidate', type=Path)
+    p.add_argument('--headers-build', type=Path, default=root / '.work/baseline')
+    p.add_argument('--headers-source', type=Path, default=root / '.work/pristine')
+    p.add_argument('--locale', action='append', dest='locales')
+    p.add_argument('--memcheck', action='store_true')
+    p.add_argument('--output', type=Path, required=True)
+    a = p.parse_args()
+    a.output.parent.mkdir(parents=True, exist_ok=True)
+    folder = a.output.resolve().with_suffix('')
+    folder.mkdir(exist_ok=True)
+    module = folder / 'psh_strtol_fixture.so'
+    source = root / 'Perf/strtol-module.c'
+    command = ['cc', '-O2', '-g', '-shared', '-fPIC', '-DMODULE', '-DHAVE_CONFIG_H',
+               '-I' + str(a.headers_build.resolve(strict=True) / 'Src'),
+               '-I' + str(a.headers_source.resolve(strict=True) / 'Src'), str(source), '-o', str(module)]
+    subprocess.run(command, check=True)
+    script = '''module_path=("$1")
+zmodload psh_strtol_fixture || exit 1
+psh-strtol-check "$2" || exit 2
+zmodload -u psh_strtol_fixture || exit 3
+print -r -- matrix-done
+'''
+    sha = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()
+    shells = [x.resolve(strict=True) for x in (a.baseline, a.candidate)]
+    fingerprints = {str(x): sha(x) for x in [*shells, source, root / 'Perf/strtol-reference.c', module]}
+    rows = []
+    for locale in a.locales or ['C', 'C.UTF-8']:
+        expected = None
+        for host, shell in enumerate(shells):
+            for mode in ['reference', 'actual']:
+                prefix = []
+                if a.memcheck:
+                    log = folder / f'{host}-{locale}-{mode}.memcheck.log'
+                    prefix = ['valgrind', '--error-exitcode=97', '--leak-check=no', '--log-file=' + str(log)]
+                result = subprocess.run(prefix + [str(shell), '-dfc', script, 'comparison', str(folder), mode],
+                    env={'PATH': '/usr/bin:/bin', 'LC_ALL': locale}, capture_output=True, timeout=300)
+                count = re.search(rb'(?m)^checks=(\d+)\nmatrix-done\n$', result.stdout)
+                if result.returncode or not count:
+                    raise RuntimeError((host, mode, locale, result.returncode, result.stderr[-1000:]))
+                value = (result.stdout, result.stderr)
+                if expected is None:
+                    expected = value
+                elif value != expected:
+                    for label, old, new in zip(['stdout', 'stderr'], expected, value):
+                        if old != new:
+                            (folder / f'mismatch-{host}-{locale}-{mode}-{label}.expected').write_bytes(old)
+                            (folder / f'mismatch-{host}-{locale}-{mode}-{label}.actual').write_bytes(new)
+                    raise RuntimeError((host, mode, locale, 'values or diagnostics differ'))
+                rows.append(dict(shell=str(shell), mode=mode, locale=locale, checks=int(count[1]),
+                    status=0, memcheck=a.memcheck, stdout_sha256=hashlib.sha256(result.stdout).hexdigest(),
+                    stderr_sha256=hashlib.sha256(result.stderr).hexdigest(), stderr_bytes=len(result.stderr)))
+                print(host, mode, locale, count[1].decode(), 'conversion checks matched', flush=True)
+    assert fingerprints == {name: sha(Path(name)) for name in fingerprints}, 'inputs changed'
+    a.output.write_text(json.dumps(dict(passed=True, compile_command=command, fingerprints=fingerprints,
+        checks=sum(x['checks'] for x in rows), runs=rows), indent=2) + '\n')
+
+
+if __name__ == '__main__':
+    main()
