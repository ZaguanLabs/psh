new file mode 100644
index 0000000..2e9bc8f
--- /dev/null
+++ b/Perf/array-bound-workload.zsh
@@ -0,0 +1,12 @@
+emulate -R zsh
+integer size=$1 index=$2 reads=$3
+typeset -a a
+# Only fixed numeric fixture arguments from the driver enter this expression.
+eval "a=( {1..$size} )"
+typeset -F 9 SECONDS=0 started elapsed
+typeset value
+started=$SECONDS
+repeat $reads; do value=${a[$index]}; done
+elapsed=$(( SECONDS - started ))
+print -r -- "$elapsed"
+print -r -- "$size:$index:$reads:${#a}:$value"
diff --git a/Perf/array-cache-lifetimes.zsh b/Perf/array-cache-lifetimes.zsh
new file mode 100644
index 0000000..94530a2
--- /dev/null
+++ b/Perf/array-cache-lifetimes.zsh
@@ -0,0 +1,56 @@
+emulate -R zsh
+module_path=("$1" $module_path)
+zmodload psh_array_cache_fixture || exit 1
+integer checks=0 i j
+for kind in getaparam getter getarrvalue; do
+  psh-cache-fixture init || exit 1
+  repeat 4; do
+    [[ -v 'psh_cache_array[1000]' && ${psh_cache_array[1000]} == item ]] || exit 2
+  done
+  psh-cache-fixture loan $kind || exit 3
+  # Keep the native loan alive while interpreter queries populate/evict caches.
+  repeat 4; do
+    [[ -v 'psh_cache_array[1000]' ]] || exit 4
+    : "${psh_cache_array[1000]}"
+  done
+  for (( i=0; i<192; i++ )); do
+    eval "psh_cache_other$i=( {1..128} )"
+    typeset other_name="psh_cache_other${i}[100]"
+    repeat 3; do
+      [[ -v $other_name ]] || exit 5
+      : "${(P)other_name}"
+    done
+  done
+  psh-cache-fixture cut || exit 6
+  repeat 4; do
+    [[ ! -v 'psh_cache_array[1000]' && ! -v 'psh_cache_array[1001]' &&
+       ${+psh_cache_array[1000]} == 0 && -z ${psh_cache_array[1000]} &&
+       -z ${psh_cache_array[1001]} ]] || exit 7
+    (( checks++ ))
+  done
+  psh-cache-fixture restore || exit 8
+  psh-cache-fixture same-set || exit 9
+  repeat 4; do
+    [[ -v 'psh_cache_array[1000]' ]] || exit 10
+    : "${psh_cache_array[1000]}"
+  done
+  psh-cache-fixture cut || exit 11
+  [[ ! -v 'psh_cache_array[1000]' && -z ${psh_cache_array[1000]} ]] || exit 12
+  (( checks++ ))
+  psh-cache-fixture restore || exit 13
+  # The fixture overallocates initially, exercising an in-place realloc on
+  # this host. If allocation moves, the old loan is invalid and is reacquired.
+  psh_cache_array+=(tail)
+  [[ ${#psh_cache_array} == 1025 && ${psh_cache_array[1025]} == tail ]] || exit 14
+  if ! psh-cache-fixture same; then psh-cache-fixture loan $kind || exit 15; fi
+  repeat 4; do
+    [[ -v 'psh_cache_array[1000]' ]] || exit 16
+    : "${psh_cache_array[1000]}"
+  done
+  psh-cache-fixture cut || exit 17
+  [[ ! -v 'psh_cache_array[1000]' && -z ${psh_cache_array[1000]} ]] || exit 18
+  (( checks++ ))
+  psh-cache-fixture restore || exit 19
+done
+zmodload -u psh_array_cache_fixture || exit 20
+print -r -- "checks=$checks"
diff --git a/Perf/array-cache-module.c b/Perf/array-cache-module.c
new file mode 100644
index 0000000..faa0ee0
--- /dev/null
+++ b/Perf/array-cache-module.c
@@ -0,0 +1,88 @@
+/* Native lifetime tests, compiled against the preceding unmodified SDK. */
+#include "zsh.mdh"
+
+static char array_name[] = "psh_cache_array";
+static char **loan;
+static char *saved_tail;
+static int cut_at;
+
+static void
+restore_loan(void)
+{
+    if (saved_tail) {
+        loan[cut_at] = saved_tail;
+        saved_tail = NULL;
+    }
+}
+
+static int
+bin_cache_fixture(UNUSED(char *name), char **args, UNUSED(Options ops), UNUSED(int func))
+{
+    Param pm = (Param)gethashnode2(paramtab, array_name);
+    if (!strcmp(args[0], "init")) {
+        char **value = (char **)zalloc(2049 * sizeof(char *));
+        int i;
+        restore_loan();
+        for (i = 0; i < 1024; i++) value[i] = ztrdup("item");
+        for (; i <= 2048; i++) value[i] = NULL;
+        loan = NULL;
+        return setaparam(array_name, value) ? 0 : 1;
+    }
+    if (!pm) return 2;
+    if (!strcmp(args[0], "loan")) {
+        if (!args[1]) return 2;
+        if (!strcmp(args[1], "getaparam")) loan = getaparam(array_name);
+        else if (!strcmp(args[1], "getter")) loan = pm->gsu.a->getfn(pm);
+        /* Deliberate contract-bypass reproducer, never a supported loan. */
+        else if (!strcmp(args[1], "raw")) loan = pm->u.arr;
+        else if (!strcmp(args[1], "getarrvalue")) {
+            struct value v;
+            memset(&v, 0, sizeof(v));
+            v.pm = pm;
+            v.isarr = SCANPM_ARRONLY;
+            v.end = -1;
+            loan = getarrvalue(&v);
+        } else return 2;
+        return loan ? 0 : 1;
+    }
+    if (!strcmp(args[0], "same")) {
+        int same = loan == pm->u.arr;
+        printf("same_pointer=%d\n", same);
+        fflush(stdout);
+        return !same;
+    }
+    if (!strcmp(args[0], "same-set")) {
+        if (!loan || loan != pm->u.arr) return 2;
+        pm->gsu.a->setfn(pm, loan);
+        return 0;
+    }
+    if (!strcmp(args[0], "cut")) {
+        if (!loan || loan != pm->u.arr || saved_tail) return 2;
+        cut_at = 3;
+        saved_tail = loan[cut_at];
+        loan[cut_at] = NULL;
+        return 0;
+    }
+    if (!strcmp(args[0], "restore")) {
+        if (!loan || loan != pm->u.arr) return 2;
+        restore_loan();
+        return 0;
+    }
+    return 2;
+}
+
+static struct builtin bintab[] = {
+    BUILTIN("psh-cache-fixture", 0, bin_cache_fixture, 1, 2, 0, NULL, NULL)
+};
+static struct features module_features = { bintab, 1, NULL, 0, NULL, 0, NULL, 0, 0 };
+int setup_(UNUSED(Module m)) { return 0; }
+int features_(Module m, char ***features) {
+    *features = featuresarray(m, &module_features); return 0;
+}
+int enables_(Module m, int **enables) { return handlefeatures(m, &module_features, enables); }
+int boot_(UNUSED(Module m)) { return 0; }
+int cleanup_(Module m) {
+    restore_loan(); loan = NULL; unsetparam(array_name);
+    return setfeatureenables(m, &module_features, NULL);
+}
+int finish_(UNUSED(Module m)) { return 0; }
diff --git a/Perf/array-cache-mutations.zsh b/Perf/array-cache-mutations.zsh
new file mode 100644
index 0000000..407e738
--- /dev/null
+++ b/Perf/array-cache-mutations.zsh
@@ -0,0 +1,57 @@
+emulate -R $1
+setopt braceexpand # authored fixture data; keep indexing/emulation options
+typeset -a a
+_psh_cache_probe() {
+  typeset n
+  for n in 64 65 128 255 256 257 511 512 513 1000 1001 0 -1 -3; do
+    print -r -- "$n:${+a[$n]}:${(qqqq)a[$n]}"
+    [[ -v "a[$n]" ]]
+    print -r -- "exists=$?"
+  done
+  print -r -- "size=${#a[@]}"
+}
+_psh_cache_local() {
+  typeset -a a=( {1..128} )
+  _psh_cache_probe
+  a[65,127]=()
+  _psh_cache_probe
+}
+for action in identity append sparse replace shrink prefix-delete middle-delete tail-delete shift unique attributes read-only-expansions shadow unset-recreate type-change; do
+  a=( {1..512} )
+  repeat 3; do _psh_cache_probe; done
+  case $action in
+    identity) ;;
+    append) a+=( {1..512} ) ;;
+    sparse) a[1000]=tail ;;
+    replace) a[100]=replacement ;;
+    shrink) a=(one two three) ;;
+    prefix-delete) a[1,100]=() ;;
+    middle-delete) a[64,400]=() ;;
+    tail-delete) a[64,-1]=() ;;
+    shift) shift 400 a ;;
+    unique) a=( ${(l:512::x:)} ); a=( ${(s::)a[1]} ); repeat 3; do _psh_cache_probe; done; typeset -U a ;;
+    attributes) typeset -L 4 a; typeset +L a ;;
+    read-only-expansions) : "${(u)a[@]}" "${(O)a[@]}" "${a[(I)3*]}" "${(j:,:)a}" ;;
+    shadow) _psh_cache_local ;;
+    unset-recreate) unset a; typeset -a a=(short) ;;
+    type-change) unset a; typeset a=scalar; unset a; typeset -a a=(new array) ;;
+  esac
+  print -r -- "action=$action"
+  repeat 3; do _psh_cache_probe; done
+  typeset +U a 2>/dev/null
+done
+integer outer
+for (( outer=0; outer<500; outer++ )); do
+  () {
+    typeset -a transient=( {1..256} )
+    [[ -v 'transient[200]' ]] || exit 31
+    [[ -v 'transient[200]' ]] || exit 32
+    # Expansions run inside prefork's queue boundary; bare -v probes do not
+    # populate the cache in the guarded implementation.
+    : "${transient[200]}"
+    transient=(short)
+    [[ ! -v 'transient[200]' ]] || exit 33
+    [[ -z ${transient[200]} ]] || exit 34
+  } || exit $?
+done
+print -r -- mutation-checks-complete
diff --git a/Perf/array-cache-raw-alias.zsh b/Perf/array-cache-raw-alias.zsh
