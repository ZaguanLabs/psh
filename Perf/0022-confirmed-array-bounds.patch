+++ b/Perf/array-cache-raw-alias.zsh
@@ -0,0 +1,17 @@
+# Negative control: demonstrate the documented raw-field native incompatibility
+# and its getter migration. The allocation/tail stay alive and are restored.
+emulate -R zsh
+module_path=("$1" $module_path)
+zmodload psh_array_cache_fixture || exit 1
+for kind in raw getter; do
+  psh-cache-fixture init || exit 2
+  repeat 4; do
+    [[ -v 'psh_cache_array[1000]' ]] || exit 3
+    : "${psh_cache_array[1000]}"
+  done
+  psh-cache-fixture loan $kind || exit 4
+  psh-cache-fixture cut || exit 5
+  print -r -- "$kind:present=${+psh_cache_array[1000]}:value=${psh_cache_array[1000]}"
+  psh-cache-fixture restore || exit 6
+done
+zmodload -u psh_array_cache_fixture || exit 7
diff --git a/Perf/check-array-cache-signals.py b/Perf/check-array-cache-signals.py
new file mode 100644
index 0000000..01d20c4
--- /dev/null
+++ b/Perf/check-array-cache-signals.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Verify unqueued [[ -v ]] calls leave private array cache metadata unchanged."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("shell", type=Path, help="shell with debugger symbols available")
+    parser.add_argument("--expect-writes", action="store_true",
+                        help="negative control for the rejected unguarded prototype")
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    shell = args.shell.resolve(strict=True)
+    output = args.output.resolve()
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.unlink(missing_ok=True)
+    # The expansion between the second and third condition populates a cache
+    # entry inside prefork's existing queue boundary. Neither cold nor warm
+    # unqueued probes may publish metadata or change signal queueing policy.
+    script = "a=({1..1024}); [[ -v 'a[500]' ]]; [[ -v 'a[600]' ]]; : \"${a[500]}\"; [[ -v 'a[700]' ]]"
+    with tempfile.TemporaryDirectory(prefix="psh-cache-signals-") as scratch:
+        driver = Path(scratch) / "check.gdb"
+        inner = f'''import gdb, json
+rows = []
+bp = gdb.Breakpoint("issetvar")
+gdb.execute("run")
+while gdb.selected_inferior().pid:
+    level = int(gdb.parse_and_eval("queueing_enabled"))
+    before = str(gdb.parse_and_eval("array_lengths"))
+    bp.enabled = False
+    gdb.execute("finish")
+    after = str(gdb.parse_and_eval("array_lengths"))
+    rows.append(dict(queue_level=level, cache_unchanged=(before == after)))
+    bp.enabled = True
+    gdb.execute("continue")
+expected_writes = {args.expect_writes!r}
+observed_writes = any(not row["cache_unchanged"] for row in rows)
+passed = len(rows) == 3 and all(row["queue_level"] == 0 for row in rows) and observed_writes == expected_writes
+report = dict(passed=passed, shell={str(shell)!r}, binary_sha256={hashlib.sha256(shell.read_bytes()).hexdigest()!r},
+              expected_writes=expected_writes, observed_writes=observed_writes, calls=rows)
+with open({str(output)!r}, "w") as out:
+    json.dump(report, out, indent=2)
+    out.write("\\n")
+if not passed:
+    raise gdb.GdbError("array cache signal-boundary check failed")
+'''
+        driver.write_text("set pagination off\nset confirm off\npython\n" + inner + "end\n")
+        command = ["gdb", "--batch", "--nx", "--quiet", "-x", str(driver),
+                   "--args", str(shell), "-dfc", script]
+        result = subprocess.run(command, env={"PATH": "/usr/bin:/bin", "LC_ALL": "C.UTF-8"},
+                                capture_output=True, timeout=60)
+        output.with_suffix(".gdb.log").write_bytes(result.stdout + result.stderr)
+        if result.returncode or not output.exists() or not json.loads(output.read_text())["passed"]:
+            raise RuntimeError("signal-boundary check failed: " + str(output.with_suffix(".gdb.log")))
+    print("Unqueued cache-write expectation verified:", args.expect_writes)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/Perf/check-array-cache.py b/Perf/check-array-cache.py
new file mode 100644
index 0000000..14d931a
--- /dev/null
+++ b/Perf/check-array-cache.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""Exercise array mutations and native vector loans using the preceding SDK."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shlex
+import subprocess
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("baseline", type=Path)
+    parser.add_argument("candidate", type=Path)
+    parser.add_argument("--headers-build", type=Path, required=True)
+    parser.add_argument("--headers-source", type=Path, required=True)
+    parser.add_argument("--cc", default="cc")
+    parser.add_argument("--locale", action="append", dest="locales")
+    parser.add_argument("--memcheck", action="store_true")
+    parser.add_argument("--raw-contract", action="store_true",
+                        help="also assert the documented raw-field difference and getter migration")
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent
+    sha = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()
+    output = args.output.resolve()
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.unlink(missing_ok=True)
+    folder = output.parent / (output.stem + "-native")
+    folder.mkdir(exist_ok=True)
+    module = folder / "psh_array_cache_fixture.so"
+    source = root / "array-cache-module.c"
+    command = shlex.split(args.cc) + ["-O2", "-g", "-shared", "-fPIC", "-DMODULE",
+        "-DHAVE_CONFIG_H", "-I" + str(args.headers_build.resolve() / "Src"),
+        "-I" + str(args.headers_source.resolve() / "Src"), str(source), "-o", str(module)]
+    subprocess.run(command, check=True)
+    shells = [args.baseline.resolve(strict=True), args.candidate.resolve(strict=True)]
+    scripts = [root / "array-cache-lifetimes.zsh", root / "array-cache-mutations.zsh"]
+    if args.raw_contract:
+        scripts.append(root / "array-cache-raw-alias.zsh")
+    fingerprints = {str(p): sha(p) for p in shells + scripts + [source]}
+    rows = []
+    # Ordinary malloc is needed to cover in-place realloc. Memcheck's realloc
+    # commonly moves instead; both lifetimes are valid and tested separately.
+    for memcheck in ([False, True] if args.memcheck else [False]):
+        for script in scripts[:2]:
+            for mode in (["zsh"] if "lifetimes" in script.name else ["zsh", "ksh", "sh"]):
+                for locale in args.locales or ["C", "C.UTF-8", "fr_BE.UTF-8"]:
+                    values = []
+                    for host, shell in zip(["baseline", "candidate"], shells):
+                        cmd = [str(shell), "-df", str(script),
+                               str(folder) if "lifetimes" in script.name else mode]
+                        if memcheck:
+                            log = folder / f"{script.stem}-{host}-{mode}-{locale}.memcheck.log"
+                            cmd = ["valgrind", "--error-exitcode=97", "--leak-check=no",
+                                   "--log-file=" + str(log)] + cmd
+                        result = subprocess.run(cmd, capture_output=True, timeout=300,
+                            env={"PATH": "/usr/bin:/bin", "LC_ALL": locale})
+                        if result.returncode or result.stderr:
+                            raise RuntimeError((cmd, result.returncode, result.stdout, result.stderr))
+                        physical = [int(line.split(b"=")[1]) for line in result.stdout.splitlines()
+                                    if line.startswith(b"same_pointer=")]
+                        normalized = b"\n".join(line for line in result.stdout.splitlines()
+                                               if not line.startswith(b"same_pointer="))
+                        values.append(normalized)
+                        rows.append(dict(script=script.name, mode=mode, locale=locale,
+                            host=host, memcheck=memcheck, status=0, command=cmd,
+                            in_place_reallocations=sum(physical),
+                            stdout_sha256=hashlib.sha256(result.stdout).hexdigest()))
+                    if values[0] != values[1]:
+                        raise RuntimeError((script, mode, locale, "different results"))
+                    print(script.name, mode, locale, "memcheck" if memcheck else "malloc",
+                          "matched", flush=True)
+    raw_contract = []
+    if args.raw_contract:
+        expected = [b"raw:present=0:value=\ngetter:present=0:value=\n",
+                    b"raw:present=1:value=item\ngetter:present=0:value=\n"]
+        for host, shell, value in zip(["baseline", "candidate"], shells, expected):
+            cmd = [str(shell), "-df", str(scripts[2]), str(folder)]
+            result = subprocess.run(cmd, capture_output=True, timeout=30,
+                                    env={"PATH": "/usr/bin:/bin", "LC_ALL": "C.UTF-8"})
+            if result.returncode or result.stderr or result.stdout != value:
+                raise RuntimeError((cmd, result.returncode, result.stdout, result.stderr))
+            raw_contract.append(dict(host=host, command=cmd, status=0,
+                                     stdout=result.stdout.decode()))
+    if fingerprints != {str(p): sha(p) for p in shells + scripts + [source]}:
+        raise RuntimeError("test inputs changed")
+    output.write_text(json.dumps(dict(passed=True, compile_command=command,
+        module_sha256=sha(module), fingerprints=fingerprints, runs=rows,
+        raw_contract=raw_contract), indent=2) + "\n")
+
+
+if __name__ == "__main__":
+    main()
