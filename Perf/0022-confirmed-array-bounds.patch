+/* Private confirmed bounds for interpreter-owned vectors. A mutable getter
+ * loan disables it for that allocation, even after cache eviction.
+ * The normal setter and parameter destructor invalidate pointer identities.
+ */
+static struct {
+    Param pm;
+    char **array;
+    unsigned bound;
+} array_lengths[64];
+
+static char *nullarray = NULL;
+
+/**/
+static void
+invalidate_array_length(Param pm)
+{
+    unsigned slot = ((size_t)pm >> 4) & 63;
+    if (array_lengths[slot].pm == pm)
+	array_lengths[slot].pm = NULL;
+}
+
+/* Interpreter-owned read: the returned vector must not escape to mutable
+ * native callers. Custom getters retain their original callback path.
+ */
+/**/
+char **
+getarrayreadonly(Param pm)
+{
+    if (pm->gsu.a == &stdarray_gsu)
+	return pm->u.arr ? pm->u.arr : &nullarray;
+    pm->node.flags |= PM_ARRAY_EXPOSED;
+    return pm->gsu.a->getfn(pm);
+}
+
+/**/
+static int
+array_length_owned(Param pm)
+{
+    return pm->gsu.a == &stdarray_gsu &&
+	!(pm->node.flags & (PM_SPECIAL|PM_TIED|PM_HASHELEM|PM_ARRAY_EXPOSED)) &&
+	!pm->ename && pm->node.nam && *pm->node.nam;
+}
+
+/* Call only after an owned, callback-free read. A cached snapshot may differ
+ * from the current vector; such snapshots retain the original scan.
+ */
+/**/
+static int
+array_length_ge(Param pm, char **arr, unsigned bound)
+{
+    unsigned slot, prefix = 0;
+    /* Do not publish or consume shared metadata where a trap can run in the
+     * middle of a probe. Preserve the caller's existing signal boundary. */
+    if (!queue_signal_level())
+	return arrlen_ge(arr, bound);
+    if (arr != pm->u.arr)
+	return arrlen_ge(arr, bound);
+    slot = ((size_t)pm >> 4) & 63;
+
+    if (array_lengths[slot].pm == pm && array_lengths[slot].array == arr) {
+	prefix = array_lengths[slot].bound;
+	if (prefix >= bound)
+	    return 1;
+    }
+    /* Ownership/invalidation guarantee prefix live entries. The following
+     * pointer may be the terminator; the bounded scan still checks it. */
+    if (!arrlen_ge(arr + prefix, bound - prefix))
+	return 0;
+    if (bound >= 64) {
+	/* Remember only the prefix this query actually validated. Never count
+	 * an entire large vector merely to answer a small index query. */
+	array_lengths[slot].pm = pm;
+	array_lengths[slot].array = arr;
+	array_lengths[slot].bound = bound;
+    }
+    return 1;
+}
+
+/**/
+int
+arrayparaminrange(Param pm, unsigned bound)
+{
+    int owned = array_length_owned(pm);
+    char **arr = getarrayreadonly(pm);
+    return owned ? array_length_ge(pm, arr, bound) : arrlen_ge(arr, bound);
+}
