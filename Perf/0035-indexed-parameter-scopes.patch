+	    HashNode hn = st.u.u;
+	    st.u.u = hn->next;
+	    scanfunc(hn, 0);
+	}
+	if (scope_valid && psh_scope_tracking()) {
+	    HashNode hn;
+	    for (hn = nodes[i]; hn; hn = hn->next)
+		if (((Param)hn)->level > 0)
