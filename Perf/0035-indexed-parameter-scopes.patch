+	 scope_size != hsize || scope_hash != ht->hash) && !scope_rebuild(ht)) {
+	scanhashtable(ht, 0, 0, 0, scanfunc, 0);
+	return;
+    }
+    st.sorted = 0;
+    impl(ht)->scan = &st;
