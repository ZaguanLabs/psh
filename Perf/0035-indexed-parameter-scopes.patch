+    if (!psh_scope_tracking() || ht != realparamtab || ht->scantab ||
+	ht->hash != hasher || ht->cmpnodes != strcmp ||
+	ht->addnode != addhashnode || ht->removenode != removehashnode ||
+	locallevel < 0 || impl(ht)->scan) {
+	scope_valid = 0;
+	scanhashtable(ht, 0, 0, 0, scanfunc, 0);
