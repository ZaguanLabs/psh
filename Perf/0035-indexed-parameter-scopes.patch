+static inline void
+scope_mark_bucket(HashTable ht, unsigned bucket)
+{
+    if (ht == scope_owner && scope_valid && ht->nodes == scope_nodes &&
+	ht->hsize == scope_size && ht->hash == scope_hash)
+	scope_bits[bucket / SCOPE_WORD_BITS] |=
+	    1UL << (bucket % SCOPE_WORD_BITS);
