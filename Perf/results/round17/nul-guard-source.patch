@@ -5677,6 +5677,22 @@
 	     * multibyte handling if we have such a character.
 	     */
 	    num++;
+	    /* Further nonzero ASCII bytes have the same state-free count.
+	     * Keep explicit-end checks before each additional read. Skip
+	     * this probe after a metafied NUL, which often repeats. */
+	    if (inchar) {
+		if (eptr) {
+		    while (ptr < eptr && (unsigned char)*ptr - 1U < 127U) {
+			ptr++;
+			num++;
+		    }
+		} else {
+		    while ((unsigned char)*ptr - 1U < 127U) {
+			ptr++;
+			num++;
+		    }
+		}
+	    }
 	    laststart = ptr;
 	    num_in_char = 0;
 	    continue;
