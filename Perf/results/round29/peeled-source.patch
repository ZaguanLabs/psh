@@ -85,12 +85,34 @@ static HashTableImpl firstht, lastht;
 mod_export unsigned
 hasher(const char *str)
 {
-    unsigned hashval = 0, c;
-
-    while ((c = *((unsigned char *) str++)))
-	hashval += (hashval << 5) + c;
