+	HashNode hn;
+	for (hn = paramtab->nodes[bucket]; hn && hn != (HashNode)pm; hn = hn->next)
+	    ;
+	if (hn)
+	    scope_mark_bucket(paramtab, bucket);
+    }
+}
+
+/**/
+mod_export void
+psh_scope_mark(Param pm)
+{
+    if (pm && pm->level > 0)
+	scope_mark_parameter(pm);
+}
+
+/* Publish a level and its candidate bucket without moving signal boundaries.
+ * Reentrant cleanup during this operation uses the ordinary scan and leaves
+ * the bitmap invalid, so it can neither miss the write nor rebuild mid-write. */
+/**/
+mod_export void
+psh_scope_setlevel(Param pm, int level)
+{
+    scope_mutating++;
+    if (level > 0)
+	scope_mark_parameter(pm);
+    pm->level = level;
+    scope_mutating--;
+}
+
+static void
+scope_invalidate(HashTable ht)
+{
+    if (ht == scope_owner)
+	scope_valid = 0;
+}
+
+static int
+scope_rebuild(HashTable ht)
+{
+    size_t words = ((size_t)ht->hsize + SCOPE_WORD_BITS - 1) / SCOPE_WORD_BITS;
+    int i, saved_errno = errno;
+    unsigned long *bits = (unsigned long *)calloc(words, sizeof(*bits));
+    errno = saved_errno;
+    if (!bits)
+	return 0;
+    free(scope_bits);
+    errno = saved_errno;
+    scope_bits = bits;
+    scope_owner = ht;
+    scope_nodes = ht->nodes;
+    scope_hash = ht->hash;
+    scope_size = ht->hsize;
+    for (i = 0; i < ht->hsize; i++) {
+	HashNode hn;
+	for (hn = ht->nodes[i]; hn; hn = hn->next)
+	    if (((Param)hn)->level > 0) {
+		scope_bits[i / SCOPE_WORD_BITS] |= 1UL << (i % SCOPE_WORD_BITS);
+		break;
+	    }
+    }
+    scope_valid = 1;
+    return 1;
+}
