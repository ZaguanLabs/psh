diff --git a/Src/hashtable.c b/Src/hashtable.c
index 75b06c4..643c22e 100644
--- a/Src/hashtable.c
+++ b/Src/hashtable.c
@@ -70,6 +70,96 @@ struct scanstatus {
     } u;
