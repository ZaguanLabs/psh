+/* Native constructors and setup run behind a conservative scope barrier.
+ * An unacknowledged module permanently retains legacy scope scans. */
+/**/
+mod_export void
+psh_scope_module_ack(Module m)
+{
+    m->node.flags |= MOD_SCOPE_TRACKED;
+}
+
 /**/
 mod_export int
 load_module(char const *name, Feature_enables enablesarr, int silent)
+{
+    Module m;
+    int ret;
+    if (!modname_ok(name))
+        return load_module_tracked_body(name, enablesarr, silent);
+    m = find_module(name, FINDMOD_ALIASP, NULL);
+    if (m && m->u.handle && (m->node.flags & MOD_SCOPE_TRACKED) &&
+        !(m->node.flags & (MOD_UNLOAD|MOD_SETUP|MOD_BUSY)))
+        return load_module_tracked_body(name, enablesarr, silent);
+    if (m && !m->u.handle)
+        m->node.flags &= ~MOD_SCOPE_TRACKED;
+    psh_scope_native_begin();
+    ret = load_module_tracked_body(name, enablesarr, silent);
+    m = find_module(name, FINDMOD_ALIASP, NULL);
+    psh_scope_native_end(ret != 1 && m && (m->node.flags & MOD_SCOPE_TRACKED));
+    return ret;
+}
