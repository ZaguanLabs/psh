+/* Length metadata is private and never used to address array storage. A
+ * mutable getter loan disables it for that allocation, even after eviction.
+ * The normal setter and parameter destructor invalidate pointer identities.
+ */
+static struct {
+    Param pm;
+    char **array;
+    int length;
+} array_lengths[64];
+
+static char *nullarray = NULL;
+
+/**/
+static void
+invalidate_array_length(Param pm)
+{
+    unsigned slot = ((size_t)pm >> 4) & 63;
+    if (array_lengths[slot].pm == pm)
+	array_lengths[slot].pm = NULL;
+}
+
+/* Interpreter-owned read: the returned vector must not escape to mutable
+ * native callers. Custom getters retain their original callback path.
+ */
+/**/
+char **
+getarrayreadonly(Param pm)
+{
+    if (pm->gsu.a == &stdarray_gsu)
+	return pm->u.arr ? pm->u.arr : &nullarray;
+    pm->node.flags |= PM_ARRAY_EXPOSED;
+    return pm->gsu.a->getfn(pm);
+}
