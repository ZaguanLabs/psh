diff --git a/Src/options.c b/Src/options.c
index a186317..442e1fb 100644
--- a/Src/options.c
+++ b/Src/options.c
@@ -519,14 +519,30 @@ setemulate(HashNode hn, int fully)
 	setemulate_opts[on->optno] = defset(on, setemulate_emulation);
 }
 
+/* The ordinary scanner has already selected non-alias emulation options. */
+/**/
+static void
+setemulate_option(HashNode hn, UNUSED(int flags))
+{
+    Optname on = (Optname)hn;
+    setemulate_opts[on->optno] = defset(on, setemulate_emulation);
+}
+
 /**/
 void
 installemulation(int new_emulation, char *new_opts)
 {
+    int fully = !!(new_emulation & EMULATE_FULLY);
+
     setemulate_emulation = new_emulation;
     setemulate_opts = new_opts;
-    scanhashtable(optiontab, 0, 0, 0, setemulate,
-		  !!(new_emulation & EMULATE_FULLY));
+    /* Generated scanners ignore selection masks.  Already queued signals
+     * keep that delegation decision stable without a new queue boundary. */
+    if (!fully && queue_signal_level() && !optiontab->scantab)
+	scanhashtable(optiontab, 0, OPT_EMULATE, OPT_ALIAS,
+		      setemulate_option, 0);
+    else
+	scanhashtable(optiontab, 0, 0, 0, setemulate, fully);
 }
 
 /**/
