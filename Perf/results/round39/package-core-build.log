gcc -E -P sigtmp.c >sigtmp.out;; \
*) \
gcc -E sigtmp.c >sigtmp.out;; \
esac
gawk -f ./signames2.awk sigtmp.out > signames.c
rm -f sigtmp.c sigtmp.out
grep 'define.*SIGCOUNT' signames.c > sigcount.h
