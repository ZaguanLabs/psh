+/**/
+static int
+execcmd_literal_quotes(Wordcode words, LinkList args)
+{
+    LinkNode node;
+    for (node = firstnode(args); node; incnode(node), words++) {
+	if (*words & 1) {
+	    unsigned char *s = (unsigned char *)getdata(node);
+	    /* Bound the extra probe to inline wordcode strings.  Longer
+	     * quoted words and every active expansion retain prefork(). */
+	    if (!(*words & 2))
+		return 0;
+	    while (*s) {
+		if (*s >= 128 && *s != (unsigned char)Snull &&
+		    *s != (unsigned char)Dnull && *s != (unsigned char)Nularg)
+		    return 0;
+		s++;
+	    }
+	}
+    }
+    return 1;
+}
+
