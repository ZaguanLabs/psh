diff --git a/Src/params.c b/Src/params.c
index f4ec8c4..e19e352 100644
--- a/Src/params.c
+++ b/Src/params.c
@@ -537,6 +537,38 @@ getparamnode(HashTable ht, const char *nam)
     return hn;
 }
 
+/* A complete one-letter postfix increment has no callbacks when both
+ * the table and integer parameter use their ordinary implementations.
+ * Called only within the arithmetic parser's existing signal queue. */
+/**/
+int
+mathpostincrement(char *text, zlong *previous)
+{
+    char name[2];
+    Param pm;
+
+    if (!queue_signal_level() || paramtab != realparamtab ||
+	paramtab->getnode != getparamnode ||
+	paramtab->getnode2 != gethashnode2 || paramtab->hash != hasher ||
+	paramtab->cmpnodes != strcmp || isset(ALLEXPORT) ||
+	idigit(*text) || inblank(*text) || inblank('+') ||
+	iident('+') || iident(0))
+	return 0;
+    if (itype_end(text, IIDENT, 0) != text + 1)
+	return 0;
+    name[0] = *text;
+    name[1] = 0;
+    pm = (Param)gethashnode2(paramtab, name);
+    if (!pm || pm->gsu.i != &stdinteger_gsu ||
+	!(pm->node.flags & PM_INTEGER) ||
+	(pm->node.flags & ~(PM_INTEGER | PM_DECLARED | PM_LOCAL)) ||
+	pm->env || pm->ename || pm->u.val == ZLONG_MAX)
+	return 0;
+    *previous = pm->gsu.i->getfn(pm);
+    pm->gsu.i->setfn(pm, *previous + 1);
+    return 1;
+}
+
 /* Copy a parameter hash table */
 
 static HashTable outtable;
