 }
 
+/* htok == 2 denotes a simple-command list whose only tokens are inert
+ * short quote markers.  Keep prefork's signal boundary and quote-removal
+ * pass; no parameter, process, command, brace or file expansion is present. */
+static void
+execcmd_prefork(LinkList args, int flags, int htok)
+{
+    if (htok == 2) {
+	LinkNode node, next;
+	queue_signals();
+	for (node = firstnode(args); node && !errflag; node = next) {
+	    next = nextnode(node);
+	    if (*(char *)getdata(node))
+		remnulargs(getdata(node));
+	    else
+		uremnode(args, node);
+	}
+	unqueue_signals();
+    } else
+	prefork(args, flags, NULL);
+}
+
 /*
