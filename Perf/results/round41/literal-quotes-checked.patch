+/**/
+static int
+execcmd_literal_quotes(LinkList args)
+{
+    LinkNode node;
+
+    for (node = firstnode(args); node; incnode(node)) {
+	unsigned char *s = (unsigned char *)getdata(node);
+	int left = 64;
+	/* Inspect every word: native edits to typtab can make stored token
+	 * flags incomplete.  Bound the extra work before legacy fallback. */
+	while (*s) {
+	    if (!left-- || (*s >= 128 && *s != (unsigned char)Snull &&
+			    *s != (unsigned char)Dnull &&
+			    *s != (unsigned char)Nularg))
+		return 0;
+	    s++;
+	}
+    }
+    return 1;
+}
+
 /**/
 static void
 execcmd_analyse(Estate state, Execcmd_params eparams)
@@ -2800,6 +2822,8 @@ execcmd_analyse(Estate state, Execcmd_params eparams)
     case WC_SIMPLE:
 	eparams->args = ecgetlist(state, WC_SIMPLE_ARGC(code), EC_DUP,
 				  &eparams->htok);
+	if (eparams->htok && execcmd_literal_quotes(eparams->args))
+	    eparams->htok = 2;
 	eparams->assignspc = NULL;
 	break;
 
@@ -2825,6 +2849,27 @@ execcmd_analyse(Estate state, Execcmd_params eparams)
