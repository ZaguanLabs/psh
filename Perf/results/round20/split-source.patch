@@ -1569,6 +1569,30 @@ mathevalarg(char *s, char **ss)
  * For this purpose, unary operators constitute part of an operand.
  */
 
+/* Keep diagnostic formatting out of the per-token check. */
+#if defined(__GNUC__)
+__attribute__((__noinline__))
+#endif
+static void
+checkunaryerror(int errmsg, char *mptr)
+{
+    int len, over = 0;
+    char *errtype = errmsg == 2 ? "operator" : "operand";
+    while (inblank(*mptr))
+	mptr++;
+    len = ztrlen(mptr);
+    if (len > 10) {
+	len = 10;
+	over = 1;
+    }
+    if (!*mptr)
+	zerr("bad math expression: %s expected at end of string",
+	    errtype);
+    else
+	zerr("bad math expression: %s expected at `%l%s'",
+	     errtype, mptr, len, over ? "..." : "");
+}
+
