+/* Scope cleanup needs only parameters above the current live locallevel.
+ * Keep the ordinary unsorted scan's successor tracking: setters and unsetters
+ * may add, remove or replace parameters while restoring the scope. */
+
+/**/
+void
+scanlocalparams(HashTable ht, ScanFunc scanfunc)
+{
+    struct scanstatus st;
+    int i, hsize;
+    HashNode *nodes;
+
+    if (ht->scantab) {
+	/* Generated tables retain their original callback and flags. */
+	ht->scantab(ht, scanfunc, 0);
+	return;
+    }
+
+    hsize = ht->hsize;
+    nodes = ht->nodes;
+    st.sorted = 0;
+    impl(ht)->scan = &st;
+
+    for (i = 0; i < hsize; i++)
+	for (st.u.u = nodes[i]; st.u.u; ) {
+	    HashNode hn = st.u.u;
+	    st.u.u = st.u.u->next;
+	    if (((Param)hn)->level > locallevel)
+		scanfunc(hn, 0);
+	}
+
+    impl(ht)->scan = NULL;
+}
+
 /* Expand hash tables when they get too many entries. *
  * The new size is 4 times the previous size.         */
 
