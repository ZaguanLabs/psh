+			HashNode hn = st.u.u;
+			st.u.u = st.u.u->next;
+			if ((!flags1 || (hn->flags & flags1)) && !(hn->flags & flags2)
+			    && (!pprog || pattry(pprog, hn->nam))) {
+			    match++;
+			    scanfunc(hn, scanflags);
+			}
+		    }
