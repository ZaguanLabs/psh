+/* Fused option-default writes for tables without a generated provider.
+ * Keep the ordinary successor and scan-time resize protocol, and read flags
+ * at the visit: output may alias later node flags. The mode and destination
+ * are the original shared callback state, including after signal reentry. */
+/**/
+void
+scanoptiondefaults(HashTable ht, int *mode, char **out, int fully,
+		   int emulate_mask, int special_mask, int alias_mask)
+{
+    struct scanstatus st;
+    int i, hsize = ht->hsize;
+    HashNode *nodes = ht->nodes;
+
+    st.sorted = 0;
+    impl(ht)->scan = &st;
+    for (i = 0; i < hsize; i++) {
+	for (st.u.u = nodes[i]; st.u.u; ) {
+	    Optname on = (Optname)st.u.u;
+	    int flags = on->node.flags;
+	    st.u.u = on->node.next;
+	    if (!(flags & alias_mask) &&
+		((fully && !(flags & special_mask)) || (flags & emulate_mask)))
+		(*out)[on->optno] = !!(flags & *mode);
+	}
+    }
+    impl(ht)->scan = NULL;
+}
+
 /* Walk candidate buckets in exactly the ordinary unsorted order. Re-read
  * the bitmap after each bucket: callbacks can mark a later bucket. */
 /**/
