+/* Fused option-default writes, called only with signals already queued and
+ * no generated provider. Keep the ordinary successor and scan-time resize
+ * protocol, and read flags at the visit: output may alias later node flags. */
+/**/
+void
+scanoptiondefaults(HashTable ht, int mode, char *out,
+		   int emulate_mask, int special_mask, int alias_mask)
+{
+    struct scanstatus st;
+    int i, hsize = ht->hsize, fully = !!(mode & EMULATE_FULLY);
+    HashNode *nodes = ht->nodes;
+
+    st.sorted = 0;
+    impl(ht)->scan = &st;
+    for (i = 0; i < hsize; i++) {
+	for (st.u.u = nodes[i]; st.u.u; ) {
+	    Optname on = (Optname)st.u.u;
+	    int flags = on->node.flags;
+	    st.u.u = on->node.next;
+	    if (!(flags & alias_mask) &&
+		((fully && !(flags & special_mask)) || (flags & emulate_mask)))
+		out[on->optno] = !!(flags & mode);
+	}
+    }
+    impl(ht)->scan = NULL;
+}
+
 /* Walk candidate buckets in exactly the ordinary unsorted order. Re-read
  * the bitmap after each bucket: callbacks can mark a later bucket. */
 /**/
