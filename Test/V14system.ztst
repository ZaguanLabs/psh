# Test zsh/system module

%prep

  if zmodload -s zsh/system && zmodload -s zsh/zselect; then
    tst_dir=V14.tmp
    mkdir -p -- $tst_dir
    : > $tst_dir/file # File on which to acquire flock.
  else
    ZTST_unimplemented='the zsh/system and zsh/zselect modules are not available'
  fi

%test

  (
    print -rn -- ABC > $tst_dir/readiness-input
    exec 0< $tst_dir/readiness-input
    exec 3<> $tst_dir/readiness-input
    typeset -A readiness=(sentinel keep)
    zselect -t 0 -A readiness -w 3 -r 3 0
    print -r -- "$?:${readiness[0]}:${readiness[3]}:${#readiness}"
    zselect -t 0 -A readiness -e 0
    print -r -- "$?:${readiness[0]}:${readiness[3]}:${#readiness}"
  )
0:zselect combines readiness flags and preserves associative results on timeout
>0:r:rw:2
>1:r:rw:2

  (
    print -rn -- ABC > $tst_dir/zselect-input
    exec 0< $tst_dir/zselect-input
    reply=(sentinel)
    zselect -t 0 -r 4294967296 2>/dev/null
    print -r -- "$?:$reply"
    typeset -A readiness=(sentinel keep)
    zselect -t 0 -A readiness -r 0 -w 4294967296 2>/dev/null
    print -r -- "$?:${readiness[sentinel]}:${#readiness}"
    zselect -t 0 -r 0
    print -r -- "$?:$reply"
  )
0:zselect checks full descriptor range before changing readiness arrays
>1:sentinel
>1:keep:1
>0:-r 0

  (
    print -rn -- ABC > $tst_dir/timeout-input
    exec 3< $tst_dir/timeout-input
    for timeout in 4294967296 1e300 -Inf Inf NaN; do
      result=unchanged count=unchanged side=0
      sysread -i 3 -s 1 -t "(++side, $timeout)" -c count result 2>/dev/null
      print -r -- "$?:$result:$count:$side"
    done
    sysread -i 3 -s 1 -t 0.5 result
    print -r -- "$?:$result"
  )
0:sysread rejects unrepresentable timeouts after evaluating them once, before I/O
>1:unchanged:unchanged:1
>1:unchanged:unchanged:1
>1:unchanged:unchanged:1
>1:unchanged:unchanged:1
>1:unchanged:unchanged:1
>0:A

  (
    print -rn -- ABC > $tst_dir/systell-input
    exec 0< $tst_dir/systell-input
    sysseek 2
    for value in 0 0.0 -0.9; do
      print -r -- $(( systell(value) ))
    done
    n=0
    print -r -- $(( systell(n++) )) $n
    for value in 4294967296 -4294967296 2147483648.0 1e300 Inf NaN; do
      (print -r -- $(( systell(value) ))) 2>/dev/null
      print -r -- "status=$?"
    done
    print -r -- $(( systell(0) ))
  )
0:systell validates before narrowing and preserves fractional truncation
>2
>2
>2
>2 1
>status=1
>status=1
>status=1
>status=1
>status=1
>status=1
>2

  (
    print -rn -- ABC > $tst_dir/integer-input
    print -rn -- KEEP > $tst_dir/integer-output
    exec 3< $tst_dir/integer-input
    exec 4<> $tst_dir/integer-output
    for shift in 4294967296 -4294967296; do
      result=unchanged count=unchanged
      sysread -i $((shift + 3)) -s 1 -c count result 2>/dev/null
      print -r -- "$?:$result:$count"
      sysread -i 3 -o $((shift + 4)) -s 1 -c count result 2>/dev/null
      print -r -- "$?:$result:$count"
      sysread -i 3 -s $((shift + 1)) -c count result 2>/dev/null
      print -r -- "$?:$result:$count"
      syswrite -o $((shift + 4)) -c count Z 2>/dev/null
      print -r -- "$?:$result:$count"
      sysseek -u $((shift + 3)) 2 2>/dev/null
      print -r -- "$?"
    done
    sysread -i 3 -s 3 result
    print -r -- "$result/$(< $tst_dir/integer-output)"
  )
0:system integer options reject wide values before narrowing or I/O
>1:unchanged:unchanged
>1:unchanged:unchanged
>1:unchanged:unchanged
>1:unchanged:unchanged
>1
>1:unchanged:unchanged
>1:unchanged:unchanged
>1:unchanged:unchanged
>1:unchanged:unchanged
>1
>ABC/KEEP

  (
    target=$tst_dir/$'name-\x83'
    decoy=$tst_dir/$'name-\x83\xa3'
    print -rn -- RIGHT > "$target"
    print -rn -- DECOY > "$decoy"
    sysopen -r -u fd -- "$target" || exit
    sysread -i $fd || exit
    print -r -- "$REPLY"
    exec {fd}<&-
    sysopen -a -u fd -- "$target" || exit
    syswrite -o $fd APPEND || exit
    exec {fd}>&-
    print -r -- "$(< "$target")/$(< "$decoy")"
    sysopen -w -o trunc -u fd -- "$target" || exit
    exec {fd}>&-
    print -r -- "$(< "$target")/$(< "$decoy")"
    rm -- "$target"
    sysopen -w -o creat,excl -u fd -- "$target" || exit
    syswrite -o $fd CREATED || exit
    exec {fd}>&-
    print -r -- "$(< "$target")/$(< "$decoy")"
  )
0:sysopen decodes filenames for reading, appending, truncating and creating
>RIGHT
>RIGHTAPPEND/DECOY
>/DECOY
>CREATED/DECOY


  (
    zsystem flock -t 0 -i 0.000001 $tst_dir/file    &&
    zsystem flock -t 0.1 -i 0.000001 $tst_dir/file  &&
    zsystem flock -t 0.1 -i 0.0000001 $tst_dir/file &&
    zsystem flock -t 1 -i 0.000001 $tst_dir/file
  )
0:zsystem flock valid time arguments

  (
    local fd=unchanged
    zsystem flock -t 0 -i NaN -f fd $tst_dir/file 2>/dev/null
    print -r -- "$?:$fd"
    zsystem flock -t 0 -i 0.0000001 -f fd $tst_dir/file
    print -r -- "$?:$(( fd >= 10 ))"
    zsystem flock -u $fd
  )
0:zsystem flock rejects NaN intervals before assigning a lock descriptor
>1:unchanged
>0:1

  (
    local fd
    zsystem flock -t 0 -f fd $tst_dir/file
    zsystem flock -u -- -1 2>/dev/null
    print -r -- "negative:$?"
    zsystem flock -u $fd
    print -r -- "unlock:$?"
    zsystem flock -u $fd 2>/dev/null
    print -r -- "closed:$?"
  )
0:zsystem flock negative unlock rejects safely and leaves the real lock intact
>negative:1
>unlock:0
>closed:1

  (
    local fd value
    zsystem flock -t 0 -f fd $tst_dir/file
    for value in 'fd + 4294967296' 1e300 Inf NaN; do
      zsystem flock -u -- "$value" 2>/dev/null
      print -r -- "rejected:$?"
    done
    zsystem flock -u -- 'fd + 0.9'
    print -r -- "fraction:$?"
  )
0:zsystem flock validates unlock arithmetic before narrowing
>rejected:1
>rejected:1
>rejected:1
>rejected:1
>fraction:0

  (
    zsystem flock -t 1073741824 $tst_dir/file ||
    zsystem flock -t 1e100      $tst_dir/file ||
    zsystem flock -i -1         $tst_dir/file ||
    zsystem flock -i 0          $tst_dir/file ||
    zsystem flock -i 1e100      $tst_dir/file
  )
1:zsystem flock invalid time arguments
?(eval):zsystem:2: flock: invalid timeout value: '1073741824'
?(eval):zsystem:3: flock: invalid timeout value: '1e100'
?(eval):zsystem:4: flock: invalid interval value: '-1'
?(eval):zsystem:5: flock: invalid interval value: '0'
?(eval):zsystem:6: flock: invalid interval value: '1e100'

  (
    # Lock file for 1 second in the background.
    lock_flag=$tst_dir/locked1
    (zsystem flock $tst_dir/file \
     && touch $lock_flag \
     && zselect -t 100
     mv $lock_flag $lock_flag.done) &
    # Wait until sub-shell above has started.
    while ! [[ -f $lock_flag || -f $lock_flag.done ]]; do
      zselect -t 1
    done
    if [[ -f $lock_flag.done ]]; then
      echo "Background shell should not have completed already." 1>&2
    else
      # Attempt to lock file with 0.5 second timeout: must fail.
      zsystem flock -t 0.5 $tst_dir/file
    fi
  )
2:zsystem flock unsuccessful wait test
F:This timing test might fail due to process scheduling issues unrelated to zsh.

  (
    # Lock file for 0.5 second in the background.
    lock_flag=$tst_dir/locked2
    (zsystem flock $tst_dir/file \
      && touch $lock_flag \
      && zselect -t 50
      mv $lock_flag $lock_flag.done) &
    # Wait until sub-shell above has started.
    while ! [[ -f $lock_flag || -f $lock_flag.done ]]; do
      zselect -t 1
    done
    if [[ -f $lock_flag.done ]]; then
      echo "Background shell should not have completed already." 1>&2
    fi
    typeset -F SECONDS
    start=$SECONDS
    # Attempt to lock file without a timeout:
    # must succeed after sub-shell above releases it (0.5 second).
    if zsystem flock $tst_dir/file; then
      elapsed=$[ $SECONDS - $start ]
      if [[ $elapsed -ge 0.3 && $elapsed -le 0.7 ]]; then
        echo "elapsed time seems OK" 1>&2
      else
        echo "elapsed time $elapsed should be ~ 0.5 second" 1>&2
      fi
    fi
  )
0:zsystem flock successful wait test, no timeout
?elapsed time seems OK
F:This timing test might fail due to process scheduling issues unrelated to zsh.

  (
    # Lock file for 0.5 second in the background.
    lock_flag=$tst_dir/locked3
    (zsystem flock $tst_dir/file \
      && touch $lock_flag \
      && zselect -t 50
      mv $lock_flag $lock_flag.done) &
    # Wait until sub-shell above has started.
    while ! [[ -f $lock_flag || -f $lock_flag.done ]]; do
      zselect -t 1
    done
    if [[ -f $lock_flag.done ]]; then
      echo "Background shell should not have completed already." 1>&2
    fi
    typeset -F SECONDS
    start=$SECONDS
    # Attempt to lock file with 1-second timeout:
    # must succeed 1 second after start because we retry every 1 second.
    if zsystem flock -t 1 $tst_dir/file; then
      elapsed=$[ $SECONDS - $start ]
      if [[ $elapsed -ge 0.8 && $elapsed -le 1.2 ]]; then
        echo "elapsed time seems OK" 1>&2
      else
        echo "elapsed time $elapsed should be ~ 1 second" 1>&2
      fi
    fi
  )
0:zsystem flock successful wait test, integral seconds
?elapsed time seems OK
F:This timing test might fail due to process scheduling issues unrelated to zsh.

  (
    # Lock file for 0.25 second in the background.
    lock_flag=$tst_dir/locked4
    (zsystem flock $tst_dir/file \
      && touch $lock_flag \
      && zselect -t 25
      mv $lock_flag $lock_flag.done) &
    # Wait until sub-shell above has started.
    while ! [[ -f $lock_flag || -f $lock_flag.done ]]; do
      zselect -t 1
    done
    if [[ -f $lock_flag.done ]]; then
      echo "Background shell should not have completed already." 1>&2
    fi
    typeset -F SECONDS
    start=$SECONDS
    # Attempt to lock file with 0.4-second timeout, retrying every 0.1 second:
    # must succeed 0.3 second after start.
    if zsystem flock -t 0.4 -i 0.1 $tst_dir/file; then
      elapsed=$[ $SECONDS - $start ]
      if [[ $elapsed -ge 0.2 && $elapsed -le 0.5 ]]; then
        echo "elapsed time seems OK" 1>&2
      else
        echo "elapsed time $elapsed should be ~ 0.3 second" 1>&2
      fi
    fi
  )
0:zsystem flock successful wait test, fractional seconds
?elapsed time seems OK
F:This timing test might fail due to process scheduling issues unrelated to zsh.

  (
    zsystem flock -t 0.1 -i 0.1 -f XYZ $tst_dir/file
    echo $XYZ
    zsystem flock -t0.1 -i0.1 -fZYX $tst_dir/file
    echo $ZYX
  )
